{
  "name": "design-viewer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "node scripts/desktop.mjs dev",
    "package": "node scripts/desktop.mjs build",
    "prepare:downloader": "node scripts/prepare-downloader.mjs",
    "prepare:media": "node scripts/prepare-media.mjs",
    "test": "tsx --test src/model.test.ts src/zoom.test.ts src/videoQueue.test.ts src/masonry.test.ts src/mediaQueue.test.ts src/homeLayout.test.ts src/sidebarSpace.test.ts src/appHistory.test.ts src/diagnosticContext.test.ts src/diagnosticEvidence.test.ts src/studio.test.ts src/calendarImport.test.ts",
    "audit:diagnostics": "node scripts/audit-diagnostics.mjs",
    "diagnose:performance": "node scripts/check-grid-return.mjs performance",
    "diagnose:processes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/monitor-performance.ps1",
    "test:clipboard-scroll": "node scripts/check-grid-return.mjs clipboard-scroll",
    "test:session": "node scripts/check-grid-return.mjs view-session",
    "test:enlarge": "node scripts/check-grid-return.mjs thumbnail-enlargement",
    "test:preview": "node scripts/check-grid-return.mjs wide-preview",
    "test:grid": "node scripts/check-grid-return.mjs",
    "test:video": "node scripts/check-grid-return.mjs video-download",
    "test:boards": "node scripts/check-grid-return.mjs link-boards",
    "test:customization": "node scripts/check-grid-return.mjs customization",
    "test:history": "node scripts/check-grid-return.mjs app-history",
    "test:home": "node scripts/check-grid-return.mjs home-styles",
    "test:categories": "node scripts/check-grid-return.mjs categories",
    "test:drag": "node scripts/check-grid-return.mjs pointer-moves",
    "test:workflow": "node scripts/check-grid-return.mjs workflow-tools",
    "test:actions": "node scripts/check-grid-return.mjs copy-resources",
    "test:native": "node scripts/desktop.mjs test",
    "check:version": "node scripts/check-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "test:export": "node scripts/check-grid-return.mjs library-export"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ffmpeg-static": "^5.2.0",
    "tsx": "4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
